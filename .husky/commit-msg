# Enforces the commit convention documented in CONVENTIONS.md:
#   <type>(#<issue>): <message in English, imperative, lowercase, no trailing period>
# e.g. feat(#50): create a new module

msg_file="$1"
# First non-comment, non-empty line = the subject.
subject=$(grep -v '^#' "$msg_file" | sed '/^[[:space:]]*$/d' | head -n 1)

# Merges, reverts and fixup/squash commits are generated by git itself.
case "$subject" in
  Merge*|Revert*|fixup!*|squash!*) exit 0 ;;
esac

pattern='^(feat|fix|docs|style|refactor|perf|test|build|ci|chore|revert)\(#[0-9]+\)!?: [a-z].{0,70}[^.]$'

if printf '%s' "$subject" | grep -Eq "$pattern"; then
  exit 0
fi

cat >&2 <<'MSG'

✖ Mensagem de commit fora do padrão.

  Formato:  <tipo>(#<issue>): <mensagem em inglês, imperativo, minúscula, sem ponto final>
  Exemplo:  feat(#50): create a new module

  Tipos:    feat, fix, docs, style, refactor, perf, test, build, ci, chore, revert
  Assunto:  até 72 caracteres

  Detalhes em CONVENTIONS.md (seção 2).

MSG
printf '  Recebido: %s\n\n' "$subject" >&2
exit 1
